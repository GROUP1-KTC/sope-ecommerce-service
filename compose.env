services:
  redis:
    image: redis:7
    container_name: redis
    ports:
      - "6379:6379"
    networks:
      - sope-ecommerce-backend-network

  elasticsearch:
    image: elasticsearch:7.9.2
    ports:
      - "9200:9200"
    environment:
      - discovery.type=single-node
    ulimits:
      memlock:
        soft: -1
        hard: -1

  # kibana:
  #   image: kibana:7.9.2
  #   container_name: kibana
  #   ports:
  #     - "5601:5601"
  #   depends_on:
  #     - elasticsearch

  logstash:
    image: logstash:7.9.2
    container_name: logstash
    depends_on:
      - elasticsearch
    ports:
      - "5000:5000"
    volumes:
      - ./lib/postgresql-42.6.0.jar:/usr/share/java/postgresql-42.6.0.jar
      - type: bind
        source: ./logstash_pipeline/
        target: /usr/share/logstash/pipeline
        read_only: true

  api-product:
    image: ${DOCKER_IMAGE_SON}:${DOCKER_TAG}
    container_name: ${DOCKER_CONTAINER}
    env_file:
      - .env
    ports:
      - "${SERV_PORT}:${SERV_PORT}"
    environment:
      SPRING_REDIS_HOST: redis
      SPRING_REDIS_PORT: 6379
    depends_on:
      - redis
    networks:
      - sope-ecommerce-backend-network

networks:
  sope-ecommerce-backend-network:
    external: true

volumes:
  pglogs:
    driver: local
